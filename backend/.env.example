FLASK_ENV=production
FLASK_DEBUG=0
# PORT is assigned dynamically by Railway at runtime (default 5000 for local dev)

# PostgreSQL Database Connection URL (Supabase)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST].supabase.co:5432/postgres

# JWT Secret Key
JWT_SECRET=replace-with-a-long-random-secret

# Google Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AI Pipeline Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_CANDIDATE_THRESHOLD=0.60
FAISS_TOP_K=10

# CORS Production Deployment
FRONTEND_URL=https://your-vercel-app.vercel.app
CORS_ORIGINS=https://your-vercel-app.vercel.app
